expenses = []

while True:
    print("\n--- Expense Tracker ---")
    print("1. Add New Expense")
    print("2. Get Totals")
    print("3. Exit")

    choice = input("Selection: ")

    if choice == "1":
        category = input("Enter Category: ")
        vendor = input("Enter Vendor: ")

        try:
            amount = float(input("Enter Amount: "))
        except ValueError:
            print("Invalid amount. Try again.")
            continue

        date = input("Enter Date: ")

        expense = {
            "category": category,
            "vendor": vendor,
            "amount": amount,
            "date": date
        }

        expenses.append(expense)
        print("Expense added.")

    elif choice == "2":
        print("\n--- Totaling Options ---")
        print("A: All Expenses")
        print("C: Filter by Category")
        print("V: Filter by Vendor")

        option = input("Choice: ").upper()

        total = 0

        if option == "A":
            for exp in expenses:
                total += exp["amount"]
            print(f"Total of all expenses: ${total:.2f}")

        elif option == "C":
            category = input("Enter Category to sum: ")
            for exp in expenses:
                if exp["category"].lower() == category.lower():
                    total += exp["amount"]
            print(f"Total for {category}: ${total:.2f}")

        elif option == "V":
            vendor = input("Enter Vendor to sum: ")
            for exp in expenses:
                if exp["vendor"].lower() == vendor.lower():
                    total += exp["amount"]
            print(f"Total for {vendor}: ${total:.2f}")

        else:
            print("Invalid option.")

    elif choice == "3":
        print("Goodbye.")
        break

    else:
        print("Invalid selection.")
